generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth ──────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Core Models ───────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  items         Item[]
  outfits       Outfit[]
  wishlistItems WishlistItem[]
  anthropicKey  String?
  createdAt     DateTime       @default(now())
}

model Item {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageUrl      String
  imagePublicId String
  thumbnailUrl  String?

  category      String
  subcategory   String?
  colors        String[]
  colorNames    String[]

  // Fashion Engine attributes
  style         String?      // casual, formal, streetwear, deportivo, elegante, smart_casual, minimalista
  formality     Int          @default(3) // 1=muy casual ... 5=muy formal
  silhouette    String?      // slim, regular, oversize, wide
  prendaType    String?      // superior, inferior, calzado, abrigo, accesorio

  brand         String?
  size          String?
  material      String?
  
  seasons       String[]
  occasions     String[]

  purchasePrice Float?
  timesWorn     Int          @default(0)
  lastWornAt    DateTime?
  favorite      Boolean      @default(false)
  archived      Boolean      @default(false)
  inLaundry     Boolean      @default(false)

  outfitItems   OutfitItem[]
  tags          Tag[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([userId, category])
}

model Outfit {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  occasion    String?
  weather     String?
  rating      Int?
  notes       String?
  shareId     String?      @unique

  items       OutfitItem[]
  plannedDate DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([shareId])
}

model OutfitItem {
  id       String @id @default(cuid())
  outfitId String
  itemId   String
  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  layer    Int    @default(0)

  @@unique([outfitId, itemId])
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name        String
  category    String?
  imageUrl    String?
  link        String?
  price       Float?
  priority    Int      @default(0)
  purchased   Boolean  @default(false)
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Tag {
  id    String @id @default(cuid())
  name  String
  items Item[]

  @@unique([name])
}
